# Supabase CLI local stack. `supabase start` prints these; the anon key is
# the same fixed demo key on every local install.
PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
PUBLIC_SUPABASE_ANON_KEY=""

# Server-only. Never prefix with PUBLIC_ — that would ship it to the browser.
# Not used by the app; kept for seeding and migration scripts.
SUPABASE_SERVICE_ROLE_KEY=""
