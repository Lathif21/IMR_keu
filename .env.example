# Neon Auth (managed Better Auth) untuk database imr_keu. Server-only.
# `neon neon-auth status` mencetak nilainya. Domain portal harus terdaftar
# sebagai trusted domain (`neon neon-auth domain add`), atau Neon Auth
# menolak setiap permintaan dengan INVALID_ORIGIN.
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.<region>.aws.neon.tech/imr_keu/auth"

# Neon Data API untuk database yang sama, TANPA akhiran /rest/v1 —
# supabase-js menambahkannya sendiri. Server-only: seluruh query berjalan
# di server dengan JWT pengguna, dan RLS yang memutuskan hasilnya.
NEON_DATA_API_URL="https://ep-xxx.apirest.<region>.aws.neon.tech/imr_keu"

# Token integrasi sistem operasional ILJ (Laravel).
#
# Nilainya harus sama persis dengan INTEGRASI_TOKEN di .env sistem
# operasional; keduanya dibandingkan dengan hash_equals di sisi sana.
#
# Server-only, tanpa awalan PUBLIC_. Dibaca lewat $env/static/private oleh
# satu action saja: tarikOperasional di /entry/[period].
#
# Kosong berarti tombol "Tarik data operasional" menolak bekerja dengan
# pesan yang jelas — bukan memanggil endpoint tanpa token.
OPERATIONAL_SYNC_TOKEN=""
