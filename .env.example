# Supabase CLI local stack. `supabase start` prints these; the anon key is
# the same fixed demo key on every local install.
PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
PUBLIC_SUPABASE_ANON_KEY=""

# Server-only. Never prefix with PUBLIC_ — that would ship it to the browser.
#
# Used by exactly one screen: /admin/users, which creates auth accounts and
# resets passwords. Read through `$env/static/private`, so SvelteKit refuses
# to bundle it into client code — that refusal is the last line of defence,
# not the first. Also used by scripts/ and the test suite.
#
# This key bypasses RLS completely. Treat it like a database password.
SUPABASE_SERVICE_ROLE_KEY=""

# Token integrasi sistem operasional ILJ (Laravel).
#
# Nilainya harus sama persis dengan INTEGRASI_TOKEN di .env sistem
# operasional; keduanya dibandingkan dengan hash_equals di sisi sana.
#
# Server-only, tanpa awalan PUBLIC_. Dibaca lewat $env/static/private oleh
# satu action saja: tarikOperasional di /entry/[period].
#
# Kosong berarti tombol "Tarik data operasional" menolak bekerja dengan
# pesan yang jelas — bukan memanggil endpoint tanpa token.
OPERATIONAL_SYNC_TOKEN=""
